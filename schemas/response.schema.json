{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rtl-receipt-test/response.schema.json",
  "title": "RTL Receipt Test Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "answer_ar", "evidence_ids", "quotes", "facts"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["SUPPORTED", "CONTRADICTED", "INSUFFICIENT"]
    },
    "answer_ar": {"type": "string"},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^E[0-9]{2}$"},
      "uniqueItems": true
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "text"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^E[0-9]{2}$"},
          "text": {"type": "string"}
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value"],
        "properties": {
          "field": {"type": "string"},
          "value": {"type": "string"}
        }
      }
    }
  }
}
